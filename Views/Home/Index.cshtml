<script>
    function iniciarReveal() {
        const observador = new IntersectionObserver((entradas) => {
            entradas.forEach(entrada => {
                if (entrada.isIntersecting) { entrada.target.classList.add('visible'); }
                else { entrada.target.classList.remove('visible'); }
            });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal').forEach(el => {
            el.classList.remove('visible');
            observador.observe(el);
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => setTimeout(iniciarReveal, 100));
    } else { setTimeout(iniciarReveal, 100); }
</script>
