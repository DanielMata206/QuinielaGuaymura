@model IEnumerable<QuinielaGuaymura.Models.RankingViewModel>

@{
    ViewData["Title"] = "Home Page";
    var primerLugar = Model?.FirstOrDefault(x => x.Posicion == 1);
    var segundoLugar = Model?.FirstOrDefault(x => x.Posicion == 2);
    var tercerLugar = Model?.FirstOrDefault(x => x.Posicion == 3);
}

<style>
    @@keyframes popupEfecto {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(20px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .tarjeta-movimiento {
        animation: popupEfecto 0.6s ease-out both;
        transition: transform 0.3s ease, box-shadow 0.3s ease !important;
    }

    @@keyframes pulsoSutil {
        0% {
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            transform: translateY(0);
            border-left-width: 5px;
        }

        50% {
            box-shadow: 0 12px 28px rgba(120,23,23,0.3);
            transform: translateY(-8px);
            border-left-color: #ffc107 !important;
            border-left-width: 9px;
        }

        100% {
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            transform: translateY(0);
            border-left-width: 5px;
        }
    }

    .animacion-datos {
        animation: pulsoSutil 3.5s infinite ease-in-out;
    }

    @@keyframes aparecerPodio {
        from {
            transform: translateY(50px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .columna-podio {
        animation: aparecerPodio 0.8s ease-out both;
    }

    .oro {
        animation-delay: 0.1s;
    }

    .plata {
        animation-delay: 0.3s;
    }

    .bronce {
        animation-delay: 0.5s;
    }

    @@keyframes oro-pulso {
        0% {
            transform: scale(1);
            box-shadow: 0 6px 12px rgba(0,0,0,0.2);
        }

        50% {
            transform: scale(1.1);
            box-shadow: 0 12px 24px rgba(255,215,0,0.6);
        }

        100% {
            transform: scale(1);
            box-shadow: 0 6px 12px rgba(0,0,0,0.2);
        }
    }

    .animacion-oro {
        animation: oro-pulso 2.8s ease-in-out infinite;
    }

    @@keyframes medalla-balanceo {
        0% {
            transform: rotate(0deg);
        }

        25% {
            transform: rotate(4deg);
        }

        75% {
            transform: rotate(-4deg);
        }

        100% {
            transform: rotate(0deg);
        }
    }

    .animacion-lateral {
        animation: medalla-balanceo 3.8s ease-in-out infinite;
        transform-origin: top center;
    }

    @@keyframes rotarBalon {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .balon-giratorio {
        animation: rotarBalon 20s linear infinite;
    }

        .balon-giratorio:hover {
            animation-play-state: paused;
            cursor: pointer;
        }

    .reveal {
        opacity: 0;
        transform: translateY(60px);
        transition: opacity 0.75s ease-out, transform 0.75s ease-out;
        will-change: opacity, transform;
    }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

    .reveal-delay-1 {
        transition-delay: 0.12s;
    }

    .reveal-delay-2 {
        transition-delay: 0.25s;
    }

    .seccion-full {
        width: 100vw;
        position: relative;
        left: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
    }

    /* ── Hero Quiniela ── */
    .hero-quiniela {
        background: linear-gradient(135deg, #4a0e0e 0%, #781717 40%, #a01f1f 70%, #781717 100%);
        padding: 80px 20px 70px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .hero-quiniela::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,215,0,0.08) 0%, transparent 60%);
            animation: rotar-fondo 15s linear infinite;
        }

    @@keyframes rotar-fondo {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .hero-quiniela h2 {
        font-size: 3.5rem;
        color: white;
        text-transform: uppercase;
        letter-spacing: 3px;
        text-shadow: 0 4px 20px rgba(0,0,0,0.4);
        position: relative;
        z-index: 1;
    }

    .hero-quiniela p {
        color: rgba(255,255,255,0.85);
        font-size: 1.2rem;
        position: relative;
        z-index: 1;
    }

    .btn-hero {
        display: inline-block;
        background: linear-gradient(135deg, #FFD700, #FFA000);
        color: #4a0e0e !important;
        font-weight: 900;
        font-size: 1.25rem;
        padding: 16px 55px;
        border-radius: 50px;
        text-decoration: none !important;
        box-shadow: 0 6px 25px rgba(255,215,0,0.5);
        transition: transform 0.2s, box-shadow 0.2s;
        position: relative;
        z-index: 1;
        border: none;
        cursor: pointer;
        font-family: 'Impact', sans-serif;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

        .btn-hero:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 12px 35px rgba(255,215,0,0.65);
            color: #4a0e0e !important;
        }

    .decoracion-hero {
        font-size: 5rem;
        position: absolute;
        opacity: 0.08;
        z-index: 0;
    }
</style>


<!-- ================================================== -->
<!--         🏆 HERO — REALIZAR QUINIELA (MODIFICADO)   -->
<!-- ================================================== -->
<div class="seccion-full hero-quiniela">

    <p style="color: #FFD700; font-size: 0.9rem; letter-spacing: 5px; text-transform: uppercase; font-weight: 700; position: relative; z-index:1;">
        FIFA WORLD CUP 2026
    </p>
    <h2 class="fuente-titulo">¡Realiza tu Quiniela!</h2>
    <p class="mt-2 mb-4">Predice los resultados de la fase de grupos y compite por el premio mayor</p>

    <div class="d-flex flex-wrap gap-3 justify-content-center" style="position: relative; z-index:1;">

        @if (Context.Session.GetString("UsuarioActivo") != null)
        {
            @if (ViewBag.YaHizoQuiniela == true)
            {
                <!-- CASO 1: El usuario ya hizo la quiniela. Botón amarillo deshabilitado de forma elegante -->
                <button class="btn-hero"
                        style="background: linear-gradient(135deg, #a89430, #b08212); color: rgba(74,14,14,0.5) !important; box-shadow: none; cursor: not-allowed;"
                        disabled
                        title="Ya realizaste tu quiniela">
                    Realizar Quiniela
                </button>
            }
            else
            {
                <!-- CASO 2: El usuario está activo pero NO ha hecho la quiniela. Botón habilitado -->
                <button class="btn-hero"
                        style="background: linear-gradient(135deg, #a89430, #b08212); color: rgba(74,14,14,0.5) !important; box-shadow: none; cursor: not-allowed;"
                        disabled
                        title="El tiempo para realizar la quiniela ha cerrado">
                    Realizar Quiniela
                </button>
            }
        }
        else
        {
            <!-- CASO 3: Nadie ha iniciado sesión. El botón abre el modal de Login -->
            <button class="btn-hero"
                    style="background: linear-gradient(135deg, #a89430, #b08212); color: rgba(74,14,14,0.5) !important; box-shadow: none; cursor: not-allowed;"
                    disabled
                    title="El tiempo para realizar la quiniela ha cerrado">
                Realizar Quiniela
            </button>
        }

        <a href="#Premio" class="btn-hero" style="background: transparent; border: 3px solid #FFD700; color: white !important; box-shadow: none;">
            Ver Premio
        </a>

    </div>

    <!-- ✅ TEXTO ACTUALIZADO CON LINK DE WHATSAPP -->
    <p class="mt-3">
        Recuerda pagar tu inscripción para participar oficialmente.
        <a href="https://wa.me/50493312364"
           target="_blank"
           style="color:#FFD700; font-weight:bold; text-decoration:none;">
            📲 Comunícate con Andrés Funes al 9331-2364
        </a>
    </p>

</div>


<!-- ================================================== -->
<!--          SECCIÓN PODIO                             -->
<!-- ================================================== -->
<div class="seccion-full reveal" style="padding: 60px 0 50px;">
    <div style="height: 4px; background: linear-gradient(90deg, #781717, #FFD700); margin-bottom: 40px;"></div>
    <div class="text-center mb-5 reveal">
        <h2 class="fuente-titulo" style="color: #781717; font-size: 2.8rem; text-transform: uppercase;">
            LÍDERES DE LA QUINIELA GUAYMURA
        </h2>
        <p class="lead text-muted">A continuación se muestran los participantes que van dominando los pronósticos en tiempo real.</p>
        <hr style="width: 150px; border-top: 3px solid #781717; margin: 0 auto;">
    </div>
    <div class="container-fluid px-4 px-md-5">
        <div class="row align-items-end justify-content-center text-center g-4" style="max-width: 1100px; margin: 0 auto;">
            <div class="col-md-4 col-12 columna-podio plata mb-4 px-md-4 reveal reveal-delay-1">
                <div class="card border-0 shadow p-3 text-center" style="border-top: 5px solid #C0C0C0 !important; border-radius: 12px;">
                    <div class="mx-auto mb-2 d-flex align-items-center justify-content-center animacion-lateral"
                         style="width:50px;height:50px;background:linear-gradient(135deg,#f0f0f0,#c0c0c0,#a3a3a3);border-radius:50%;border:2px solid #333;box-shadow:0 4px 6px rgba(0,0,0,0.4);color:#222;font-weight:bold;font-size:1.25rem;">
                        2
                    </div>
                    <h4 class="fuente-titulo mt-2 mb-1" style="color:#333;font-size:1.25rem;">@(segundoLugar?.NombreUsuario ?? "Vacante")</h4>
                    <p class="badge bg-secondary px-3 py-2 mb-2" style="font-size:1rem;">@(segundoLugar?.PuntajeTotal ?? 0) Pts</p>
                    <small class="text-muted">2° Lugar</small>
                </div>
            </div>
            <div class="col-md-4 col-12 columna-podio oro mb-4 px-md-3 reveal">
                <div class="card border-0 shadow-lg p-4 text-center" style="border-top:6px solid #FFD700 !important;transform:scale(1.1);border-radius:15px;position:relative;z-index:10;">
                    <div class="position-absolute top-0 start-50 translate-middle" style="margin-top:-10px;">
                        <div class="d-flex align-items-center justify-content-center animacion-oro"
                             style="width:65px;height:65px;background:linear-gradient(135deg,#FFF700,#FFD700,#FFA000);border-radius:50%;border:3px solid #FFF700;box-shadow:0 6px 18px rgba(255,215,0,0.45);color:#551010;font-weight:bold;font-size:1.7rem;">
                            1
                        </div>
                    </div>
                    <h3 class="fuente-titulo mt-4 mb-1" style="color:#FFD700;font-size:1.6rem;">@(primerLugar?.NombreUsuario ?? "Vacante")</h3>
                    <p class="badge px-4 py-2 mb-2 text-dark" style="background-color:#FFD700;font-size:1.1rem;font-weight:bold;">@(primerLugar?.PuntajeTotal ?? 0) Pts</p>
                    <small style="font-weight:bold;color:#FFD700;">1° Lugar</small>
                </div>
            </div>
            <div class="col-md-4 col-12 columna-podio bronce mb-4 px-md-4 reveal reveal-delay-2">
                <div class="card border-0 shadow p-3 text-center" style="border-top:5px solid #CD7F32 !important;border-radius:12px;">
                    <div class="mx-auto mb-2 d-flex align-items-center justify-content-center animacion-lateral"
                         style="width:50px;height:50px;background:linear-gradient(135deg,#f5cba7,#dc7633,#a04000);border-radius:50%;border:2px solid #333;box-shadow:0 4px 6px rgba(0,0,0,0.4);color:#fff;font-weight:bold;font-size:1.25rem;">
                        3
                    </div>
                    <h4 class="fuente-titulo mt-2 mb-1" style="color:#333;font-size:1.25rem;">@(tercerLugar?.NombreUsuario ?? "Vacante")</h4>
                    <p class="badge px-3 py-2 mb-2 text-white" style="font-size:1rem;background-color:#CD7F32;">@(tercerLugar?.PuntajeTotal ?? 0) Pts</p>
                    <small class="text-muted">3° Lugar</small>
                </div>
            </div>
        </div>
    </div>
    <div style="height:4px;background:linear-gradient(90deg,#FFD700,#781717);margin:40px auto 0;"></div>
</div>


<!-- ================================================== -->
<!--          SECCIÓN: TABLA DE POSICIONES              -->
<!-- ================================================== -->
<div class="container">
    <div id="tabla-posiciones" class="row justify-content-center mt-5" style="scroll-margin-top:100px;">
        <div class="col-lg-10 reveal">
            <div class="card p-4 border-0 bg-light shadow-sm" style="border-radius:12px;">
                <h3 class="fuente-titulo mb-4 text-center" style="color:#781717;border-bottom:2px solid #781717;padding-bottom:8px;font-size:1.5rem;">
                    Tabla General de Posiciones
                </h3>
                <div class="table-responsive">
                    <table class="table table-hover align-middle bg-white rounded shadow-sm overflow-hidden">
                        <thead style="background-color:#781717;color:white;">
                            <tr>
                                <th class="text-center" style="width:100px;">Posición</th>
                                <th>Participante</th>
                                <th class="text-center">Partidos Acertados</th>
                                <th class="text-center" style="width:150px;">Puntaje Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var usuario in Model)
                                {
                                    string claseFila = usuario.Posicion == 1 ? "table-warning" : "";
                                    string estiloFila = usuario.Posicion <= 3 ? "font-weight:bold;" : "";
                                    <tr class="@claseFila" style="@estiloFila">
                                        <td class="text-center">@usuario.Posicion</td>
                                        <td>@(usuario.Posicion == 1 ? "⭐ " : "")@usuario.NombreUsuario</td>
                                        <td class="text-center">@usuario.PartidosAcertados</td>
                                        <td class="text-center">
                                            @if (usuario.Posicion == 1)
                                            {
                                                <span class="badge text-dark" style="background-color:#FFD700;font-size:0.95rem;">@usuario.PuntajeTotal Pts</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-dark opacity-75">@usuario.PuntajeTotal Pts</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center text-muted py-4">No hay datos disponibles en el ranking actualmente.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- ================================================== -->
<!--          SECCIÓN PREMIO                            -->
<!-- ================================================== -->
<div id="Premio" class="seccion-full reveal mt-5" style="scroll-margin:100px;">
    <div style="position:relative;background-image:url('/img/Fondo.png');background-size:cover;background-position:center;">
        <div style="position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.65);z-index:1;"></div>
        <div style="position:relative;z-index:2;" class="py-5">
            <h3 class="fuente-titulo mb-4 text-center" style="color:white;border-bottom:2px solid #FFFFFF;padding-bottom:8px;font-size:1.5rem;max-width:600px;margin:0 auto 1.5rem;">
                Premio para el Líder de la Quiniela
            </h3>
            <div class="text-center">
                <img src="~/img/premio.png" alt="Premio" class="img-fluid rounded-circle balon-giratorio"
                     style="width:250px;height:250px;object-fit:cover;"
                     onerror="this.src='https://images.unsplash.com/photo-1508098682722-e99c43a406b2?q=80&w=400'">
                <p class="mt-4 fuente-lectura" style="font-size:1.1rem;color:#fff;max-width:600px;margin:0 auto;text-shadow:1px 1px 4px rgba(0,0,0,0.8);">
                    El líder del ranking al finalizar la quiniela se llevará el balón oficial del Mundial 2026 ¡La Triona!
                </p>
            </div>
        </div>
    </div>
</div>


<!-- ================================================== -->
<!--             HISTORIA + DATOS CURIOSOS              -->
<!-- ================================================== -->
<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8 col-md-7 mb-4 reveal">
            <h2 class="fuente-titulo mb-4" style="color:#781717;font-size:2.2rem;border-bottom:2px solid #781717;padding-bottom:10px;">
                La Historia de la Copa Mundial
            </h2>
            <p class="lead text-muted mb-4">La Copa Mundial de la FIFA es el torneo de fútbol masculino internacional más importante del mundo, un evento que paraliza al planeta cada cuatro años.</p>
            <p class="fuente-lectura" style="font-size:1.1rem;line-height:1.8;color:#333;">
                Todo comenzó en <strong>1930</strong>, cuando la FIFA organizó el primer torneo en Uruguay. Solo participaron 13 selecciones invitadas y el país anfitrión se coronó campeón tras vencer a Argentina.
            </p>
            <p class="fuente-lectura" style="font-size:1.1rem;line-height:1.8;color:#333;">
                A lo largo de las décadas, el torneo dejó momentos inolvidables como el "Maracanazo" en 1950, el auge de Pelé, la era de Maradona en 1986, hasta la coronación de Lionel Messi en Catar 2022.
            </p>
            <p class="fuente-lectura" style="font-size:1.1rem;line-height:1.8;color:#333;">
                Ahora, con la mirada puesta en el <strong>Mundial 2026</strong>, el torneo se expande a 48 equipos en Estados Unidos, México y Canadá.
            </p>
        </div>
        <div class="col-lg-4 col-md-5 reveal reveal-delay-2">
            <div class="card tarjeta-login animacion-datos p-4 bg-light border-0" style="border-left:5px solid #781717 !important;border-radius:14px;">
                <h4 class="fuente-titulo mb-3" style="color:#781717;">Datos Curiosos</h4>
                <hr class="mt-0">
                <ul class="list-unstyled">
                    <li class="mb-3"><strong>🏆 Más Campeón:</strong> Brasil es el máximo ganador con 5 estrellas.</li>
                    <li class="mb-3"><strong>⚽ Máximo Goleador:</strong> Miroslav Klose con 16 goles anotados.</li>
                    <li class="mb-3"><strong>📅 Próxima Cita:</strong> Mundial 2026 en Estados Unidos, México y Canadá.</li>
                </ul>
            </div>
        </div>
    </div>
</div>


<!-- ================================================== -->
<!--          MUNDIALES LEGENDARIOS                     -->
<!-- ================================================== -->
<div class="container">
    <div class="mb-5 px-0" style="margin-top:80px !important;padding-top:60px;border-top:3px solid rgba(120,23,23,0.18);">
        <div class="text-center mb-5 reveal">
            <h2 class="fuente-titulo" style="color:#781717;font-size:2.8rem;text-transform:uppercase;">Grandes Campeones y Mundiales Legendarios</h2>
            <p class="lead text-muted">Un repaso por el juego bonito, las eras doradas y las mayores sorpresas.</p>
            <hr style="width:150px;border-top:3px solid #781717;margin:0 auto;">
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="tarjeta-movimiento card tarjeta-login p-4 mb-5 border-0 bg-light shadow-sm reveal">
                    <h3 class="fuente-titulo" style="color:#781717;">ARGENTINA 2022 (La Gloria Eterna)</h3>
                    <span class="badge align-self-start mb-3 px-3 py-2 text-dark" style="background-color:#FFD700 !important;font-weight:bold;">La tercera estrella esperada</span>
                    <div class="text-center my-3 bg-dark rounded-3 overflow-hidden" style="max-height:400px;">
                        <img src="~/img/Argentina.jpg" alt="Argentina 2022" class="img-fluid w-100" style="object-fit:cover;" onerror="this.src='https://images.unsplash.com/photo-1671377484481-fc1733dfba15?q=80&w=1200'" />
                    </div>
                    <p class="fuente-lectura mt-3" style="font-size:1.1rem;line-height:1.8;">
                        La Argentina de <strong>Lionel Messi</strong> protagonizó la mejor final de todos los tiempos ante Francia. Un 3-3 épico y penales definitivos donde el 'Dibu' Martínez se vistió de héroe.Y por fin se le cumplio
                        el sueño a Lionel Messi de ser campeón del mundo gracias a un plantel de jovenes y jugadores experimentados que llevaron al titulo a la Argentina de Messi con una actuacion increible en los siete partidos disputados en el mundial
                    </p>
                </div>
                <div class="tarjeta-movimiento card tarjeta-login p-4 mb-5 border-0 bg-light shadow-sm reveal">
                    <h3 class="fuente-titulo" style="color:#781717;">BRASIL 2002 (El Pentacampeón)</h3>
                    <span class="badge align-self-start mb-3 px-3 py-2 text-dark" style="background-color:#FFD700 !important;font-weight:bold;">El Último Mundial Ganado por Brasil</span>
                    <div class="text-center my-3 bg-dark rounded-3 overflow-hidden" style="max-height:400px;">
                        <img src="~/img/brasil.jpg" alt="Brasil 2002" class="img-fluid w-100" style="object-fit:cover;" onerror="this.src='https://images.unsplash.com/photo-1518063319789-7217e6706b04?q=80&w=1200'" />
                    </div>
                    <p class="fuente-lectura mt-3" style="font-size:1.1rem;line-height:1.8;">
                        La redención de <strong>Ronaldo Nazário</strong> en Asia. Doblete en la final ante Alemania para la quinta estrella del Pentacampeón. La ultima gran Brasil que vimos en los mundiales fue la del 2002
                        con un futbol feliz como siempre los caracteriza que es el "Jogo bonito" con un Rivaldo impresionante Kaká que venia despuntando como estrella y el joven Ronaldinho que venia a impresionar al mundo con sus regates.
                    </p>
                </div>
                <div class="tarjeta-movimiento card tarjeta-login p-4 mb-5 border-0 bg-light shadow-sm reveal">
                    <h3 class="fuente-titulo" style="color:#781717;">ESPAÑA 2010 (La Era del Tiquitaca)</h3>
                    <span class="badge bg-danger align-self-start mb-3 px-3 py-2">El Mejor Estilo de Juego Moderno</span>
                    <div class="text-center my-3 bg-dark rounded-3 overflow-hidden" style="max-height:400px;">
                        <img src="~/img/espana.jpg" alt="España 2010" class="img-fluid w-100" style="object-fit:cover;" onerror="this.src='https://images.unsplash.com/photo-1508098682722-e99c43a406b2?q=80&w=1200'" />
                    </div>
                    <p class="fuente-lectura mt-3" style="font-size:1.1rem;line-height:1.8;">
                        El <strong>"Tiquitaca"</strong> de Xavi e Iniesta conquistó el mundo. Gol de Iniesta en el 116' para la primera estrella española. Una españa que creo un estilo de juego en el futbol un estilo efectivo y de control
                        que a dia de hoy se sigue practicando por muchos equipos de elite una seleccion que sorprendio por el orden tanto defensivo y ofensivo que realizo durante el mundial.
                    </p>
