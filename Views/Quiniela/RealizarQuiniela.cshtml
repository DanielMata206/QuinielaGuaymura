@model Dictionary<string, List<QuinielaGuaymura.Models.PartidoViewModel>>

@{
    ViewData["Title"] = "Realizar Quiniela";

    var banderas = new Dictionary<string, string>
    {
        {"México", "mx"}, {"Sudáfrica", "za"}, {"República de Corea", "kr"}, {"República Checa", "cz"},
        {"Canadá", "ca"}, {"Bosnia y Herzegovina", "ba"}, {"Catar", "qa"}, {"Suiza", "ch"},
        {"Brasil", "br"}, {"Marruecos", "ma"}, {"Haití", "ht"}, {"Escocia", "gb-sct"},
        {"Estados Unidos", "us"}, {"Paraguay", "py"}, {"Australia", "au"}, {"Turquía", "tr"},
        {"Alemania", "de"}, {"Curazao", "cw"}, {"Costa de Marfil", "ci"}, {"Ecuador", "ec"},
        {"Países Bajos", "nl"}, {"Japón", "jp"}, {"Suecia", "se"}, {"Túnez", "tn"},
        {"Bélgica", "be"}, {"Egipto", "eg"}, {"Irán", "ir"}, {"Nueva Zelanda", "nz"},
        {"España", "es"}, {"Cabo Verde", "cv"}, {"Arabia Saudita", "sa"}, {"Uruguay", "uy"},
        {"Francia", "fr"}, {"Senegal", "sn"}, {"Irak", "iq"}, {"Noruega", "no"},
        {"Austria", "at"}, {"Jordania", "jo"}, {"Argentina", "ar"}, {"Argelia", "dz"},
        {"Portugal", "pt"}, {"RD Congo", "cd"}, {"Uzbekistán", "uz"}, {"Colombia", "co"},
        {"Inglaterra", "gb-eng"}, {"Croacia", "hr"}, {"Ghana", "gh"}, {"Panamá", "pa"}
    };

    string Bandera(string pais)
    {
        if (!banderas.ContainsKey(pais)) return "<span style='font-size:1.8rem'>🏳️</span>";
        var code = banderas[pais];
        return $"<img src='https://flagcdn.com/48x36/{code}.png' width='48' height='36' alt='{pais}' style='border-radius:3px; object-fit:cover;' />";
    }
}

<style>
    .quiniela-header {
        background: linear-gradient(135deg, #781717, #a01f1f);
        color: white;
        padding: 40px 0 30px;
        text-align: center;
        margin-bottom: 40px;
    }

    .tab-grupo {
        background: none;
        border: 2px solid #781717;
        color: #781717;
        border-radius: 8px;
        padding: 6px 18px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.95rem;
    }

        .tab-grupo.activo, .tab-grupo:hover {
            background-color: #781717;
            color: white;
        }

    .seccion-grupo {
        display: none;
    }

        .seccion-grupo.activa {
            display: block;
        }

    .card-partido {
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 18px 20px;
        margin-bottom: 16px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: box-shadow 0.2s;
    }

        .card-partido:hover {
            box-shadow: 0 4px 16px rgba(120,23,23,0.13);
            border-color: #781717;
        }

    .pais-nombre {
        font-weight: bold;
        font-size: 1.1rem;
        color: #333;
    }

    .bandera {
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 6px;
    }

    .input-goles {
        width: 65px;
        text-align: center;
        font-size: 1.3rem;
        font-weight: bold;
        border: 2px solid #ccc;
        border-radius: 8px;
        padding: 4px;
        color: #781717;
    }

        .input-goles:focus {
            border-color: #781717;
            outline: none;
            box-shadow: 0 0 0 3px rgba(120,23,23,0.15);
        }

    .vs-texto {
        font-size: 1rem;
        color: #999;
        font-weight: bold;
        margin: 0 8px;
    }

    .fecha-partido {
        font-size: 0.82rem;
        color: #888;
        margin-top: 8px;
    }

    .btn-enviar {
        background: linear-gradient(135deg, #781717, #a01f1f);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 14px 50px;
        font-size: 1.2rem;
        font-weight: bold;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 15px rgba(120,23,23,0.3);
    }

        .btn-enviar:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(120,23,23,0.4);
        }

    .grupo-titulo {
        color: #781717;
        font-family: 'Impact', sans-serif;
        font-size: 1.6rem;
        border-bottom: 3px solid #781717;
        padding-bottom: 8px;
        margin-bottom: 20px;
    }
</style>


<!-- ================================================== -->
<!--         SECCIÓN: GRUPOS DEL MUNDIAL 2026           -->
<!-- ================================================== -->
<div class="seccion-full reveal">

    <div style="width: auto; height: 4px; background: linear-gradient(90deg, #781717, #FFD700, #781717); margin: 0 auto 50px;"></div>

    <div class="text-center mb-5 reveal">
        <p class="text-uppercase mb-2" style="color: #781717; font-size: 0.85rem; letter-spacing: 4px; font-weight: 600;">FIFA WORLD CUP 2026</p>
        <h2 class="fuente-titulo" style="color: #781717; font-size: 2.8rem; text-transform: uppercase;">
            Grupos del Mundial 2026
        </h2>
        <p class="lead" style="color: #0a0a0a;">Conoce las 48 selecciones clasificadas divididas en 12 grupos</p>
        <hr style="width: 150px; border-top: 3px solid #781717; margin: 0 auto;">
    </div>

    <div class="container-fluid px-4 px-md-5" style="max-width: 1300px; margin: 0 auto;">
        <div class="row g-4 justify-content-center">

            @{
                var grupos = new List<(string Nombre, List<(string Pais, string Codigo, string FlagCode)> Selecciones)>
                        {
                        ("GROUP A", new List<(string,string,string)> {
                        ("México","MEX","mx"),("Sudáfrica","RSA","za"),("República de Corea","KOR","kr"),("República Checa","CZE","cz")
                        }),
                        ("GROUP B", new List<(string,string,string)> {
                        ("Canadá","CAN","ca"),("Bosnia y Herzegovina","BIH","ba"),("Catar","QAT","qa"),("Suiza","SUI","ch")
                        }),
                        ("GROUP C", new List<(string,string,string)> {
                        ("Brasil","BRA","br"),("Marruecos","MAR","ma"),("Haití","HAI","ht"),("Escocia","SCO","gb-sct")
                        }),
                        ("GROUP D", new List<(string,string,string)> {
                        ("Estados Unidos","USA","us"),("Paraguay","PAR","py"),("Australia","AUS","au"),("Turquía","TUR","tr")
                        }),
                        ("GROUP E", new List<(string,string,string)> {
                        ("Alemania","GER","de"),("Curazao","CUR","cw"),("Costa de Marfil","CIV","ci"),("Ecuador","ECU","ec")
                        }),
                        ("GROUP F", new List<(string,string,string)> {
                        ("Países Bajos","NED","nl"),("Japón","JPN","jp"),("Suecia","SWE","se"),("Túnez","TUN","tn")
                        }),
                        ("GROUP G", new List<(string,string,string)> {
                        ("Bélgica","BEL","be"),("Egipto","EGY","eg"),("Irán","IRI","ir"),("Nueva Zelanda","NZL","nz")
                        }),
                        ("GROUP H", new List<(string,string,string)> {
                        ("España","ESP","es"),("Cabo Verde","CPV","cv"),("Arabia Saudita","KSA","sa"),("Uruguay","URU","uy")
                        }),
                        ("GROUP I", new List<(string,string,string)> {
                        ("Francia","FRA","fr"),("Senegal","SEN","sn"),("Irak","IRQ","iq"),("Noruega","NOR","no")
                        }),
                        ("GROUP J", new List<(string,string,string)> {
                        ("Argentina","ARG","ar"),("Argelia","ALG","dz"),("Austria","AUT","at"),("Jordania","JOR","jo")
                        }),
                        ("GROUP K", new List<(string,string,string)> {
                        ("Portugal","POR","pt"),("RD Congo","COD","cd"),("Uzbekistán","UZB","uz"),("Colombia","COL","co")
                        }),
                        ("GROUP L", new List<(string,string,string)> {
                        ("Inglaterra","ENG","gb-eng"),("Croacia","CRO","hr"),("Ghana","GHA","gh"),("Panamá","PAN","pa")
                        }),
                        };
            }

            @foreach (var g in grupos)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-12 reveal">
                    <div class="h-100"
                         style="background: #fff; border: 1px solid rgba(120,23,23,0.25); border-top: 3px solid #781717; border-radius: 12px; overflow: hidden; transition: transform 0.3s ease, box-shadow 0.3s ease;"
                         onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 16px 40px rgba(120,23,23,0.25)'"
                         onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='none'">

                        <!-- Cabecera -->
                        <div style="background: linear-gradient(135deg, #781717, #a01f1f); padding: 14px 20px;">
                            <span class="fuente-titulo" style="color: white; font-size: 1.1rem; font-weight: 800; letter-spacing: 2px;">@g.Nombre</span>
                        </div>

                        <!-- Selecciones -->
                        <div style="padding: 8px 0;">
                            @foreach (var s in g.Selecciones)
                            {
                                <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 20px; border-bottom: 1px solid rgba(120,23,23,0.08); transition: background 0.2s;"
                                     onmouseover="this.style.background='rgba(120,23,23,0.05)'"
                                     onmouseout="this.style.background='transparent'">
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        @if (!string.IsNullOrEmpty(s.FlagCode))
                                        {
                                            <img src="https://flagcdn.com/32x24/@(s.FlagCode).png"
                                                 width="32" height="24"
                                                 alt="@s.Pais"
                                                 style="border-radius: 3px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span style="font-size: 1.2rem;">🏳️</span>
                                        }
                                        <span style="color: #222; font-size: 0.92rem; font-weight: 500;">@s.Pais</span>
                                    </div>
                                    <span style="color: #781717; font-size: 0.75rem; font-weight: 700; letter-spacing: 1px; background: rgba(120,23,23,0.08); padding: 2px 8px; border-radius: 4px;">@s.Codigo</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>

    <div style="width: auto; height: 4px; background: linear-gradient(90deg, #781717, #FFD700, #781717); margin: 50px auto 0;"></div>
</div>


<!-- ================================================== -->
<!--              ENCABEZADO QUINIELA                   -->
<!-- ================================================== -->
<div class="quiniela-header">
    <h1 class="fuente-titulo" style="font-size: 2.5rem; letter-spacing: 2px;">REALIZAR QUINIELA</h1>
    <p style="opacity: 0.85; font-size: 1.1rem;">Ingresa tu predicción para cada partido de la fase de grupos</p>
    <p style="opacity: 0.7; font-size: 0.9rem;">
        🟡 <strong>2 puntos</strong> por acertar el ganador &nbsp;|&nbsp;
        🟢 <strong>2 puntos extra</strong> por acertar el marcador exacto
    </p>
</div>

<div class="container" style="max-width: 850px;">

    <form asp-controller="Quiniela" asp-action="GuardarQuiniela" method="post">
        @Html.AntiForgeryToken()

        <!-- Tabs de grupos -->
        <div class="d-flex flex-wrap gap-2 justify-content-center mb-4">
            @foreach (var grupo in Model.Keys)
            {
                <button type="button"
                        class="tab-grupo @(grupo == Model.Keys.First() ? "activo" : "")"
                        onclick="mostrarGrupo('@grupo', this)">
                    GRUPO @grupo
                </button>
            }
        </div>

        <!-- Partidos por grupo -->
        @foreach (var grupo in Model)
        {
            <div id="grupo-@grupo.Key" class="seccion-grupo @(grupo.Key == Model.Keys.First() ? "activa" : "")">

                <h3 class="grupo-titulo">GRUPO @grupo.Key</h3>

                @foreach (var partido in grupo.Value)
                {
                    <div class="card-partido">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">

                            <!-- País Local -->
                            <div class="text-center" style="min-width: 140px;">
                                <div class="bandera">@Html.Raw(Bandera(partido.PaisLocal))</div>
                                <div class="pais-nombre">@partido.PaisLocal</div>
                            </div>

                            <!-- Inputs de goles -->
                            <div class="d-flex align-items-center gap-2">
                                <input type="number"
                                       name="local_@partido.IdPartido"
                                       class="input-goles"
                                       min="0" max="20"
                                       placeholder="0"
                                       required />
                                <span class="vs-texto">VS</span>
                                <input type="number"
                                       name="visitante_@partido.IdPartido"
                                       class="input-goles"
                                       min="0" max="20"
                                       placeholder="0"
                                       required />
                            </div>

                            <!-- País Visitante -->
                            <div class="text-center" style="min-width: 140px;">
                                <div class="bandera">@Html.Raw(Bandera(partido.PaisVisitante))</div>
                                <div class="pais-nombre">@partido.PaisVisitante</div>
                            </div>

                        </div>

                        <!-- Fecha -->
                        <div class="fecha-partido text-center">
                            📅 @partido.FechaPartido.ToString("dddd, dd 'de' MMMM 'de' yyyy — HH:mm", new System.Globalization.CultureInfo("es-ES"))
                        </div>
                    </div>
                }

                @* Botón solo visible en el Grupo L *@
                @if (grupo.Key == "L")
                {
                    <div class="text-center my-5">
                        <button type="submit" class="btn-enviar">
                            🏆 Enviar Quiniela Completa
                        </button>
                        <p class="text-muted mt-3" style="font-size: 0.85rem;">
                            Puedes volver a enviar para actualizar tus predicciones antes de que inicie cada partido.
                        </p>
                    </div>
                }

            </div>
        }

    </form>
</div>

<script>
    function mostrarGrupo(grupo, boton) {
        document.querySelectorAll('.seccion-grupo').forEach(s => s.classList.remove('activa'));
        document.querySelectorAll('.tab-grupo').forEach(b => b.classList.remove('activo'));
        document.getElementById('grupo-' + grupo).classList.add('activa');
        boton.classList.add('activo');
    }
</script>
