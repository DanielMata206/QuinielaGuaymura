<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quiniela Guaymura</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuinielaGuaymura.styles.css" asp-append-version="true" />

    <style>
        /* Gran contenedor unificado */
        .navbar-unificada {
            /* Dejamos que los rellenos grandes se controlen adentro para romper el límite de Bootstrap */
            padding-top: 20px !important;
            padding-bottom: 20px !important;
            border-bottom: none !important;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15) !important;
        }

        /* Bloque central de bienvenida - ¡Aquí controlamos el tamaño gigante! */
        .seccion-bienvenida {
            margin-top: 40px;
            padding-top: 60px !important; /* Espacio extra hacia arriba */
            padding-bottom: 90px !important; /* Espacio extra hacia abajo para lucir el fondo */
        }

        .titulo-gigante {
            font-size: 4.5rem; /* Letras más imponentes y grandes */
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            line-height: 1.1;
        }

        .subtitulo-quiniela {
            font-size: 1.4rem; /* Un poco más grande para que sea legible */
            opacity: 0.9;
        }
    </style>
</head>
<body>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-@TempData["TipoMensaje"] alert-dismissible fade show text-center fw-bold"
             role="alert"
             style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%);
                    z-index: 9999; min-width: 350px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark navbar-unificada box-shadow position-relative">
            <div class="container">
                <div class="w-100">

                    <div class="position-absolute end-0 top-0 mt-2 me-4" style="z-index: 1050;">
                        <div class="navbar-collapse collapse flex-grow-0">
                            <ul class="navbar-nav gap-2">
                                @if (Context.Session.GetString("UsuarioActivo") != null)
                                {
                                    <li class="nav-item d-flex align-items-center">
                                        <span class="text-white fw-bold fuente-menu me-2">
                                            @Context.Session.GetString("UsuarioActivo")
                                        </span>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-white fuente-menu boton-login px-3"
                                           asp-controller="Account" asp-action="Logout">
                                            Cerrar Sesión
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-white fuente-menu boton-login px-3"
                                           href="#" data-bs-toggle="modal" data-bs-target="#modalLogin">
                                            Iniciar Sesión
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-white fuente-menu boton-login px-3"
                                           href="#" data-bs-toggle="modal" data-bs-target="#modalRegistro">
                                            Registrarse
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>




                    <div class="d-flex justify-content-center my-2">
                        <ul class="navbar-nav flex-row gap-4">
                            <li class="nav-item">
                                <a class="nav-link text-white enlace-menu-central px-2" asp-area="" asp-controller="Quiniela" asp-action="Ranking">Ranking</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white enlace-menu-central px-2" asp-area="" asp-controller="Quiniela" asp-action="Participantes">Participantes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white enlace-menu-central px-2" asp-area="" asp-controller="Quiniela" asp-action="Tabla">Ver Tabla</a>
                            </li>
                        </ul>
                    </div>




                    <div class="seccion-bienvenida text-white text-wrap container mt-4">
                        <div class="row align-items-center">

                            <div class="col-2 text-start ps-4">
                                <img src="~/img/logoGuaymura.png" style="max-width: 130px; height: auto;" />
                            </div>

                            <div class="col-8 text-center">
                                <h1 class="titulo-gigante m-0">QUINIELA GUAYMURA</h1>
                                <p class="subtitulo-quiniela mt-3 mb-0">Bienvenidos a la Quiniela de Guaymura.</p>
                            </div>

                            <div class="col-2"></div>

                        </div>
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-light text-center py-3">
        <div class="container">
            &copy; 2026 - Quiniela Guaymura
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- ===== MODALES DE AUTENTICACIÓN ===== -->
    <!-- Modal Iniciar Sesión -->
    <div class="modal fade" id="modalLogin" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content border-0" style="border-radius: 15px; overflow: hidden;">

                <div class="modal-header text-white border-0 pb-1" style="background-color: #781717;">
                    <h5 class="modal-title fuente-titulo w-100 text-center" style="font-size: 1.5rem; letter-spacing: 1px;">
                        Iniciar Sesión
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body px-4 py-4">
                    <form asp-controller="Account" asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-bold" style="color: #781717;">Usuario</label>
                            <input type="text" name="NombreUsuario" class="form-control"
                                   placeholder="Ingresa tu usuario" required
                                   style="border: 2px solid #ddd; border-radius: 8px; padding: 10px 14px;">
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold" style="color: #781717;">Contraseña</label>
                            <input type="password" name="Contrasena" class="form-control"
                                   placeholder="Ingresa tu contraseña" required
                                   style="border: 2px solid #ddd; border-radius: 8px; padding: 10px 14px;">
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn text-white fw-bold py-2"
                                    style="background-color: #781717; border-radius: 8px; font-size: 1.05rem;">
                                Entrar
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-3">
                        <small class="text-muted">
                            ¿No tienes cuenta?
                            <a href="#" class="fw-bold"
                               style="color: #781717; text-decoration: none;"
                               data-bs-dismiss="modal"
                               data-bs-toggle="modal"
                               data-bs-target="#modalRegistro">
                                Regístrate aquí
                            </a>
                        </small>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Modal Registrarse -->
    <div class="modal fade" id="modalRegistro" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content border-0" style="border-radius: 15px; overflow: hidden;">

                <div class="modal-header text-white border-0 pb-1" style="background-color: #781717;">
                    <h5 class="modal-title fuente-titulo w-100 text-center" style="font-size: 1.5rem; letter-spacing: 1px;">
                        Registrarse
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body px-4 py-4">
                    <form asp-controller="Account" asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-bold" style="color: #781717;">Usuario</label>
                            <input type="text" name="NombreUsuario" class="form-control"
                                   placeholder="Elige un nombre de usuario" required
                                   style="border: 2px solid #ddd; border-radius: 8px; padding: 10px 14px;">
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold" style="color: #781717;">Contraseña</label>
                            <input type="password" name="Contrasena" class="form-control"
                                   placeholder="Elige una contraseña" required
                                   style="border: 2px solid #ddd; border-radius: 8px; padding: 10px 14px;">
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn text-white fw-bold py-2"
                                    style="background-color: #781717; border-radius: 8px; font-size: 1.05rem;">
                                Crear Cuenta
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-3">
                        <small class="text-muted">
                            ¿Ya tienes cuenta?
                            <a href="#" class="fw-bold"
                               style="color: #781717; text-decoration: none;"
                               data-bs-dismiss="modal"
                               data-bs-toggle="modal"
                               data-bs-target="#modalLogin">
                                Inicia sesión aquí
                            </a>
                        </small>
                    </div>
                </div>

            </div>
        </div>
    </div>
</body>
</html>